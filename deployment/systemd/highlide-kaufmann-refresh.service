[Unit]
Description=HIGHLIDE Kaufmann inventory refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/scraping_engine
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/flock --verbose -w 43200 -E 75 /tmp/highlide-inventory-refresh.lock /bin/bash /root/scraping_engine/scripts/run_kaufmann_refresh.sh
# Allow up to 12h of lock waiting plus the existing 12h refresh budget.
TimeoutStartSec=25h
# Retry lock exhaustion (75); partial/parser failures (1) await the next timer.
Restart=on-failure
RestartSec=15min
RestartPreventExitStatus=1
Nice=10
StandardOutput=append:/root/scraping_engine/logs/kaufmann_refresh.log
StandardError=append:/root/scraping_engine/logs/kaufmann_refresh.log
