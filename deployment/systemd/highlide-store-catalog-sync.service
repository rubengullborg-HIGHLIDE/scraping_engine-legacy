[Unit]
Description=HIGHLIDE resumable weekly catalog batches for all stores
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/scraping_engine
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/scraping_engine/.venv/bin/python /root/scraping_engine/scripts/run_catalog_batches.py --checkpoint /root/scraping_engine/logs/catalog-cycle.json --scheduled
TimeoutStartSec=14h
KillMode=mixed
TimeoutStopSec=45s
Nice=10
StandardOutput=append:/root/scraping_engine/logs/store_catalog_sync.log
StandardError=append:/root/scraping_engine/logs/store_catalog_sync.log
