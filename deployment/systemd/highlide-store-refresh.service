[Unit]
Description=HIGHLIDE sequential non-Kaufmann inventory refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/scraping_engine
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/flock -w 43200 /tmp/highlide-inventory-refresh.lock /bin/bash /root/scraping_engine/scripts/run_store_refresh.sh --all
TimeoutStartSec=20h
Nice=10
StandardOutput=append:/root/scraping_engine/logs/store_refresh.log
StandardError=append:/root/scraping_engine/logs/store_refresh.log
