[Unit]
Description=HIGHLIDE resumable inventory refresh for all stores
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/scraping_engine
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/scraping_engine/.venv/bin/python /root/scraping_engine/scripts/run_inventory_batches.py --checkpoint /root/scraping_engine/logs/daily-inventory-cycle.json --scheduled
TimeoutStartSec=90min
Nice=10
StandardOutput=append:/root/scraping_engine/logs/store_refresh.log
StandardError=append:/root/scraping_engine/logs/store_refresh.log
